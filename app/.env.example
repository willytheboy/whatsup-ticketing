# WhatsUp Ticketing — app environment
# All values are optional: the app falls back to the shared WhatsUp Lebanon Supabase project (public anon key, RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=https://xhwmgnhspyaqsgggvujo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tenant slug served by this deployment (tenants.slug)
NEXT_PUBLIC_TENANT=lb
# "ticketing" (default) or "backoffice". The backoffice role sends "/" to /admin.
# The whatsup-backoffice Vercel project is also detected by hostname, so this is optional there.
NEXT_PUBLIC_APP_ROLE=ticketing
# Absolute URL of the back-office deployment (used by the "Back office" tab for admins)
NEXT_PUBLIC_BACKOFFICE_URL=https://whatsup-backoffice-app.vercel.app
# AI layer (Track B): concierge, vibe creator, poster-to-listing. Optional — without a key the /api/ai route answers from the catalogue with plain rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Platform WhatsApp number for the concierge hand-off and support (digits only, international)
NEXT_PUBLIC_SUPPORT_WA=96170000000
#
# ---- Supabase edge function secrets (set with `supabase secrets set KEY=value`, not here) ----
# TICKET_SECRET            HMAC key for ticket tokens (WU1/WU2). Defaults to the service role key; set a dedicated one before launch.
# APP_URL                  https://whatsup-ticketing-app.vercel.app (links in messages and hosted-checkout return URLs)
# PAYMENTS_MODE            sandbox (default) | live
# PAYMENTS_PROVIDER        stripe | areeba | whish   — plus the provider's credentials:
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
#   AREEBA_MERCHANT_ID, AREEBA_API_PASSWORD, AREEBA_GATEWAY_URL
#   WHISH_CHANNEL, WHISH_SECRET, WHISH_WEBSITE_URL, WHISH_API_URL
# PAYMENTS_SANDBOX_SECRET  optional, lets test rigs mark sandbox orders paid through payment-webhook
# WHATSAPP_TOKEN, WHATSAPP_PHONE_ID, WHATSAPP_OTP_TEMPLATE, WHATSAPP_TEXT_MODE, WA_TPL_<TEMPLATE>   (Meta Cloud API; see docs/WHATSAPP-TEMPLATES.md)
# RESEND_API_KEY, EMAIL_FROM                                                                    (email copies of tickets and receipts)
# NOTIFY_SECRET            must equal app_settings.notify_secret (pg_cron → notify function)
# SEND_SMS_HOOK_SECRET     Supabase Auth "Send SMS" hook secret (WhatsApp OTP)
